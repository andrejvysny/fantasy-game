[physics]

3d/physics_engine="Jolt Physics"

[rendering]

environment/ssao/quality=1
environment/volumetric_fog/volume_size=48
environment/volumetric_fog/volume_depth=48

[shader_globals]

player_position={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
cloud_offset={
"type": "vec2",
"value": Vector2(0, 0)
}
cloud_shadow_strength={
"type": "float",
"value": 0.3
}
shadow_tint={
"type": "color",
"value": Color(0.12, 0.22, 0.2, 0.3)
}
brush_noise={
"type": "sampler2D",
"value": "res://materials/brush_noise.tres"
}
